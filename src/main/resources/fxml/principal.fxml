<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.TelaPrincipalController" styleClass="janela">
 <top><VBox spacing="12" styleClass="cabecalho">
  <Label text="TaskManager" styleClass="titulo"/>
  <Label text="Organize suas tarefas com praticidade" styleClass="subtitulo"/>
  <HBox spacing="10" alignment="CENTER_LEFT">
   <Button text="+ Nova tarefa" onAction="#novaTarefa" styleClass="primario"/>
   <Button text="Editar" onAction="#editarSelecionada"/>
   <Button text="Concluir / Reabrir" onAction="#alternarConclusao"/>
   <Button text="Excluir" onAction="#excluirSelecionada" styleClass="perigo"/>
   <Button text="Atualizar" onAction="#atualizar"/>
  </HBox>
 </VBox></top>
 <center><VBox spacing="12" styleClass="conteudo">
  <HBox spacing="15" alignment="CENTER_LEFT">
   <TextField fx:id="campoBusca" promptText="Buscar por título ou descrição..." HBox.hgrow="ALWAYS"/>
   <CheckBox fx:id="apenasPendentes" text="Somente pendentes"/>
  </HBox>
  <TableView fx:id="tabela" VBox.vgrow="ALWAYS" placeholder="Nenhuma tarefa encontrada">
   <columns>
    <TableColumn fx:id="colunaId" text="ID" prefWidth="65"/>
    <TableColumn fx:id="colunaTitulo" text="Título" prefWidth="220"/>
    <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="290"/>
    <TableColumn fx:id="colunaPrioridade" text="Prioridade" prefWidth="105"/>
    <TableColumn fx:id="colunaStatus" text="Situação" prefWidth="125"/>
   </columns>
  </TableView>
  <Label fx:id="contador" text="Total: 0" styleClass="rodape"/>
 </VBox></center>
</BorderPane>
